{
  "name": "visotalk-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "tsc:engine": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test:engine": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "vocabulary": "node --experimental-strip-types scripts/generate-vocabulary.mjs",
    "visotalk": "node --experimental-strip-types packages/cli/src/main.ts",
    "regression": "node --experimental-strip-types tests/regression/run.ts"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "typescript": "5.6.3"
  }
}
