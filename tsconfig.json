{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {"@visotalk/runtime": ["./packages/runtime/src/index.ts"], "@visotalk/jsx": ["./packages/jsx/index.ts"]}
  },
  "include": ["spec/ir/0.6", "spec/ir/0.7", "packages/*/src", "packages/jsx", "tests", "scripts/*.test.ts", "examples/**/*.ts"]
}
